# Fart Online room service configuration: copy to /etc/fartonline/rooms.env on the server (see Backend/README.md, section 3.3).
PORT=8080
BIND=127.0.0.1
# Supabase project (Project Settings > API). The anon key is public.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Shared with the game servers through their environment (never shipped in a client). 32+ random characters.
TICKET_SECRET=CHANGE-ME-openssl-rand-hex-32
# The Unity Linux dedicated server build
GAME_SERVER_BIN=/opt/fartonline/server/FartOnlineServer.x86_64
GAME_SERVER_ARGS=-batchmode -nographics
# Public hostname players connect to (an Elastic IP as a free sslip.io name: 1.2.3.4 -> 1-2-3-4.sslip.io)
PUBLIC_HOST=1-2-3-4.sslip.io
PUBLIC_PORT_BASE=7800
INTERNAL_PORT_BASE=17800
# t3.micro (1 GB): 2 rooms; t3.small (2 GB): 5; t3.medium (4 GB): 10
MAX_ROOMS=2
# 1 = Caddy terminates TLS on the public ports (production); 0 = game servers listen on the public ports (local tests)
TLS=1
# LOCAL TESTS ONLY: accept "Bearer dev:<name>" without Supabase (refused when TLS=1)
DEV_AUTH=0
